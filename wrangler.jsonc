{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jszrwz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "SUPPORT_FILES",
      "bucket_name": "jszr-support-files"
    }
  ]
}
