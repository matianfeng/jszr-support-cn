{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jszrwz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "SUPPORT_FILES",
      "bucket_name": "jszr-support-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wendang",
      "database_id": "58e83767-3833-45f0-b394-2ef4e149e422"
    }
  ]
}
