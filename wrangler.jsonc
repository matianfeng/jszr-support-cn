{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jszrwz",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/api/*"]
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "10001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "r2_buckets": [
    {
      "binding": "SUPPORT_FILES",
      "bucket_name": "jszr-support-files"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wendang",
      "database_id": "58e83767-3833-45f0-b394-2ef4e149e422"
    }
  ]
}
